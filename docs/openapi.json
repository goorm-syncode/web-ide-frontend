{
  "openapi": "3.1.0",
  "info": { "title": "SynCode WebIDE API", "description": "Web IDE API", "version": "1.0.0" },
  "servers": [{ "url": "https://d1jum4zzr45u1b.cloudfront.net" }],
  "security": [{ "Bearer Authentication": [] }],
  "tags": [
    { "name": "Mission Progress", "description": "미션 진행 상태 API" },
    { "name": "User", "description": "사용자 API" },
    { "name": "Mission", "description": "문제 관련 API" },
    { "name": "Auth", "description": "인증 API" }
  ],
  "paths": {
    "/api/missions/{missionId}/progress": {
      "get": {
        "tags": ["Mission Progress"],
        "summary": "미션 진행 상태 조회",
        "description": "진행 기록이 없으면 NOT_STARTED를 반환합니다.",
        "operationId": "getProgress",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMissionProgressResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      },
      "post": {
        "tags": ["Mission Progress"],
        "summary": "미션 진행 상태 저장/갱신",
        "description": "미션의 진행 상태를 upsert 방식으로 저장합니다.\n- IN_PROGRESS: 미션 시작 또는 현재 상태 유지 (idempotent)\n- COMPLETED: 미션 완료 처리 (기존 기록 없이 직접 저장 가능)\n- COMPLETED → IN_PROGRESS 전이는 허용되지 않습니다 (400)\n",
        "operationId": "saveOrUpdateProgress",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MissionProgressRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMissionProgressResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "회원가입",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignupRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseSignupResponse" } }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "토큰 재발급 (rotation)",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseTokenResponse" } }
            }
          }
        }
      }
    },
    "/api/auth/password-reset": {
      "post": {
        "tags": ["Auth"],
        "summary": "비밀번호 재설정 요청",
        "description": "미구현 - 이메일 발송 로직 추후 추가 예정",
        "operationId": "passwordReset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordResetRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseVoid" } } }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그아웃",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RefreshTokenRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseVoid" } } }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseTokenResponse" } }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["User"],
        "summary": "내 정보 조회",
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseUserResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      },
      "patch": {
        "tags": ["User"],
        "summary": "내 정보 수정 (닉네임)",
        "operationId": "updateMe",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdateRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseUserResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/users/me/password": {
      "patch": {
        "tags": ["User"],
        "summary": "비밀번호 변경",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PasswordChangeRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseVoid" } } }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/users/me/progress": {
      "get": {
        "tags": ["User"],
        "summary": "사용자 전체 진행률 조회",
        "operationId": "getMyProgress",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseUserProgressResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions": {
      "get": {
        "tags": ["Mission"],
        "summary": "문제 목록 조회",
        "description": "로그인한 사용자의 미션 목록을 조회합니다.\n- category, difficulty 필터 지원 (미입력 시 전체 조회)\n- 정렬: displayOrder ASC 고정 (클라이언트 sort 파라미터 무시)\n- page 기본값 0, 0 미만은 0으로 보정\n- size 기본값 20, 1 미만은 20 / 100 초과는 100으로 보정\n",
        "operationId": "getMissions",
        "parameters": [
          { "name": "category", "in": "query", "required": false, "schema": { "type": "string" } },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseMissionPageResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/{missionId}": {
      "get": {
        "tags": ["Mission"],
        "summary": "문제 상세 조회",
        "description": "문제 풀이 화면 진입 시 호출. 공개 테스트케이스만 반환. 비활성/미존재 문제는 404.",
        "operationId": "getMissionDetail",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMissionDetailResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/continue": {
      "get": {
        "tags": ["Mission"],
        "summary": "이어하기 문제 조회",
        "description": "사용자가 다음에 이어서 풀 문제 1개를 추천합니다. IN_PROGRESS 우선, 없으면 시작 안 한 문제 중 displayOrder 최솟값. 추천 없으면 mission: null.",
        "operationId": "getContinueLearning",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseContinueLearningResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/health": {
      "get": {
        "tags": ["health-controller"],
        "operationId": "health",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "MissionProgressRequest": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["IN_PROGRESS", "COMPLETED"] } },
        "required": ["status"]
      },
      "ApiResponseMissionProgressResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/MissionProgressResponse" }
        }
      },
      "MissionProgressResponse": {
        "type": "object",
        "properties": {
          "missionId": { "type": "integer", "format": "int64" },
          "status": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"] }
        }
      },
      "SignupRequest": {
        "type": "object",
        "description": "회원가입 요청",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "이메일",
            "example": "user@example.com",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "비밀번호 (8~72자)",
            "example": "Password123!",
            "maxLength": 72,
            "minLength": 8,
            "pattern": "^(?=.*[A-Z])(?=.*[a-z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).{8,}$"
          },
          "nickname": {
            "type": "string",
            "description": "닉네임 (2~50자)",
            "example": "홍길동",
            "maxLength": 50,
            "minLength": 2
          }
        },
        "required": ["email", "nickname", "password"]
      },
      "ApiResponseSignupResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/SignupResponse" }
        }
      },
      "SignupResponse": {
        "type": "object",
        "description": "회원가입 응답",
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "사용자 ID" },
          "email": { "type": "string", "description": "이메일" },
          "nickname": { "type": "string", "description": "닉네임" },
          "role": { "type": "string", "description": "역할", "enum": ["ADMIN", "USER"] }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "description": "토큰 재발급 / 로그아웃 요청",
        "properties": {
          "refreshToken": { "type": "string", "description": "Refresh Token", "minLength": 1 }
        },
        "required": ["refreshToken"]
      },
      "ApiResponseTokenResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/TokenResponse" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "description": "토큰 응답",
        "properties": {
          "accessToken": { "type": "string", "description": "Access Token" },
          "refreshToken": { "type": "string", "description": "Refresh Token" },
          "tokenType": { "type": "string", "description": "토큰 타입", "example": "Bearer" },
          "accessExpiration": {
            "type": "integer",
            "format": "int64",
            "description": "Access Token 만료 시간 (ms)"
          },
          "refreshExpiration": {
            "type": "integer",
            "format": "int64",
            "description": "Refresh Token 만료 시간 (ms)"
          }
        }
      },
      "PasswordResetRequest": {
        "type": "object",
        "description": "비밀번호 재설정 요청",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "이메일",
            "example": "user@example.com",
            "minLength": 1
          }
        },
        "required": ["email"]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": {}
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "로그인 요청",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "이메일",
            "example": "user@example.com",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "description": "비밀번호",
            "example": "Password123!",
            "minLength": 1
          }
        },
        "required": ["email", "password"]
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": { "nickname": { "type": "string", "maxLength": 50, "minLength": 0 } },
        "required": ["nickname"]
      },
      "ApiResponseUserResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/UserResponse" }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "email": { "type": "string" },
          "nickname": { "type": "string" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] }
        }
      },
      "PasswordChangeRequest": {
        "type": "object",
        "properties": {
          "currentPassword": { "type": "string", "minLength": 1 },
          "newPassword": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "pattern": "^(?=.*[A-Z])(?=.*[a-z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).{8,}$"
          }
        },
        "required": ["currentPassword", "newPassword"]
      },
      "ApiResponseUserProgressResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/UserProgressResponse" }
        }
      },
      "UserProgressResponse": {
        "type": "object",
        "properties": {
          "totalMissionCount": { "type": "integer", "format": "int64" },
          "completedMissionCount": { "type": "integer", "format": "int64" },
          "inProgressMissionCount": { "type": "integer", "format": "int64" },
          "progressPercent": { "type": "number", "format": "double" }
        }
      },
      "ApiResponseMissionPageResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/MissionPageResponse" }
        }
      },
      "MissionListItemResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
          "displayOrder": { "type": "integer", "format": "int32" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"] }
        }
      },
      "MissionPageResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/MissionListItemResponse" }
          },
          "page": { "type": "integer", "format": "int32" },
          "size": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "last": { "type": "boolean" }
        }
      },
      "ApiResponseMissionDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/MissionDetailResponse" }
        }
      },
      "MissionDetailResponse": {
        "type": "object",
        "properties": {
          "missionId": { "type": "integer", "format": "int64" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
          "category": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "publicTestCases": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PublicTestCaseResponse" }
          },
          "userStatus": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"] }
        }
      },
      "PublicTestCaseResponse": {
        "type": "object",
        "properties": {
          "inputData": { "type": "string" },
          "expectedOutput": { "type": "string" },
          "displayOrder": { "type": "integer", "format": "int32" }
        }
      },
      "ApiResponseContinueLearningResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ContinueLearningResponse" }
        }
      },
      "ContinueLearningResponse": {
        "type": "object",
        "properties": { "mission": { "$ref": "#/components/schemas/MissionSummary" } }
      },
      "MissionSummary": {
        "type": "object",
        "properties": {
          "missionId": { "type": "integer", "format": "int64" },
          "title": { "type": "string" },
          "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
          "category": { "type": "string" },
          "displayOrder": { "type": "integer", "format": "int32" },
          "status": { "type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "COMPLETED"] }
        }
      }
    },
    "securitySchemes": {
      "Bearer Authentication": {
        "type": "http",
        "name": "Bearer Authentication",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
