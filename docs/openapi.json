{
  "openapi": "3.1.0",
  "info": { "title": "SynCode WebIDE API", "description": "Web IDE API", "version": "1.0.0" },
  "servers": [{ "url": "https://d1jum4zzr45u1b.cloudfront.net" }],
  "tags": [
    { "name": "Mission Progress", "description": "미션 진행 상태 API" },
    { "name": "Submission History", "description": "제출 이력 조회 API" },
    { "name": "User", "description": "사용자 API" },
    { "name": "Draft", "description": "코드 드래프트 API" },
    { "name": "Mission", "description": "문제 관련 API" },
    { "name": "Runner", "description": "코드 실행 API" },
    { "name": "Auth", "description": "인증 API" }
  ],
  "paths": {
    "/api/missions/{missionId}/draft": {
      "get": {
        "tags": ["Draft"],
        "summary": "드래프트 불러오기",
        "description": "저장된 드래프트를 불러옵니다. 없으면 hasSavedCode=false를 반환하며 클라이언트는 starterCode로 대체합니다.",
        "operationId": "load",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "language",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["C", "CPP", "JAVA", "JAVASCRIPT", "GO", "PYTHON", "KOTLIN"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseDraftResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      },
      "put": {
        "tags": ["Draft"],
        "summary": "드래프트 저장",
        "description": "현재 작업 중인 코드를 드래프트로 저장합니다. 동일 언어의 드래프트가 있으면 덮어씁니다.",
        "operationId": "save",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SaveDraftRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseVoid" } } }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/runner/submissions": {
      "post": {
        "tags": ["Runner"],
        "summary": "코드 제출 및 채점",
        "description": "미션의 모든 테스트케이스(히든 포함)에 코드를 제출하고 채점 결과를 반환합니다. 채점 전 드래프트를 자동 저장합니다.",
        "operationId": "submit",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SubmissionRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseSubmissionResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/runner/executions": {
      "post": {
        "tags": ["Runner"],
        "summary": "코드 실행",
        "description": "소스 코드를 Judge0에 제출하고 실행 결과를 반환합니다. missionId를 입력하면 실행 전 드래프트를 자동 저장합니다. 미입력 시 드래프트 저장 없이 실행만 수행합니다.",
        "operationId": "execute",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ExecutionRequest" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseExecutionResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/{missionId}/progress": {
      "get": {
        "tags": ["Mission Progress"],
        "summary": "미션 진행 상태 조회",
        "description": "진행 기록이 없으면 NOT_STARTED를 반환합니다.",
        "operationId": "getProgress",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMissionProgressResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      },
      "post": {
        "tags": ["Mission Progress"],
        "summary": "미션 진행 상태 저장/갱신",
        "description": "미션의 진행 상태를 upsert 방식으로 저장합니다.\n- IN_PROGRESS: 미션 시작 또는 현재 상태 유지 (idempotent)\n- COMPLETED: 미션 완료 처리 (기존 기록 없이 직접 저장 가능)\n- COMPLETED → IN_PROGRESS 전이는 허용되지 않습니다 (400)\n",
        "operationId": "saveOrUpdateProgress",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MissionProgressRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMissionProgressResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/auth/signup": {
      "post": {
