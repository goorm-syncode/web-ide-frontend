        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/users/me/progress": {
      "get": {
        "tags": ["User"],
        "summary": "사용자 전체 진행률 조회",
        "operationId": "getMyProgress",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseUserProgressResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions": {
      "get": {
        "tags": ["Mission"],
        "summary": "문제 목록 조회",
        "description": "로그인한 사용자의 미션 목록을 조회합니다.\n- category, difficulty, status, keyword 필터 지원 (미입력 시 전체 조회)\n- status: ALL(기본) | NOT_STARTED | IN_PROGRESS | COMPLETED\n  - NOT_STARTED는 DB 저장 상태가 아닌 파생 상태 (progress row 없음)\n- keyword: 제목(title) 기준 부분 일치, 대소문자 무시\n- 정렬: displayOrder ASC 고정 (클라이언트 sort 파라미터 미지원)\n- page 기본값 0, 0 미만은 0으로 보정\n- size 기본값 20, 1 미만은 20 / 100 초과는 100으로 보정\n",
        "operationId": "getMissions",
        "parameters": [
          { "name": "category", "in": "query", "required": false, "schema": { "type": "string" } },
          {
            "name": "difficulty",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["ALL", "NOT_STARTED", "IN_PROGRESS", "COMPLETED"]
            }
          },
          { "name": "keyword", "in": "query", "required": false, "schema": { "type": "string" } },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ApiResponseMissionPageResponse" } }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/{missionId}": {
      "get": {
        "tags": ["Mission"],
        "summary": "문제 상세 조회",
        "description": "문제 풀이 화면 진입 시 호출. 공개 테스트케이스만 반환. 비활성/미존재 문제는 404.",
        "operationId": "getMissionDetail",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMissionDetailResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/{missionId}/submissions": {
      "get": {
        "tags": ["Submission History"],
        "summary": "제출 이력 목록",
        "description": "해당 미션에 대한 내 제출 이력을 최신순으로 반환합니다.",
        "operationId": "listSubmissions",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseListSubmissionSummaryResponse"
                }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/{missionId}/submissions/{submissionId}": {
      "get": {
        "tags": ["Submission History"],
        "summary": "제출 이력 상세",
        "description": "특정 제출의 상세 정보를 반환합니다. 본인 제출이 아니면 404를 반환합니다.",
        "operationId": "getSubmission",
        "parameters": [
          {
            "name": "missionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "submissionId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseSubmissionDetailResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/missions/continue": {
      "get": {
        "tags": ["Mission"],
        "summary": "이어하기 문제 조회",
        "description": "사용자가 다음에 이어서 풀 문제 1개를 추천합니다. IN_PROGRESS 우선, 없으면 시작 안 한 문제 중 displayOrder 최솟값. 추천 없으면 mission: null.",
        "operationId": "getContinueLearning",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/ApiResponseContinueLearningResponse" }
              }
            }
          }
        },
        "security": [{ "Bearer Authentication": [] }]
      }
    },
    "/api/health": {
      "get": {
        "tags": ["health-controller"],
        "operationId": "health",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "SaveDraftRequest": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "description": "프로그래밍 언어",
            "enum": ["C", "CPP", "JAVA", "JAVASCRIPT", "GO", "PYTHON", "KOTLIN"],
            "example": "PYTHON"
          },
          "code": { "type": "string", "description": "작업 중인 소스 코드", "minLength": 1 }
        },
        "required": ["code", "language"]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": {}
        }
      },
      "SubmissionRequest": {
        "type": "object",
        "properties": {
          "missionId": { "type": "integer", "format": "int64", "description": "미션 ID" },
          "sourceCode": { "type": "string", "description": "제출할 소스 코드", "minLength": 1 },
          "language": {
            "type": "string",
            "description": "프로그래밍 언어",
            "enum": ["C", "CPP", "JAVA", "JAVASCRIPT", "GO", "PYTHON", "KOTLIN"],
            "example": "PYTHON"
          }
        },
        "required": ["language", "missionId", "sourceCode"]
      },
      "ApiResponseSubmissionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/SubmissionResponse" }
        }
      },
      "SubmissionResponse": {
        "type": "object",
        "properties": {
          "submissionId": { "type": "integer", "format": "int64", "description": "제출 ID" },
          "overallStatus": {
            "type": "string",
            "description": "전체 채점 결과",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "WRONG_ANSWER",
              "COMPILE_ERROR",
              "RUNTIME_ERROR",
              "TIME_LIMIT_EXCEEDED",
              "SYSTEM_ERROR"
            ]
          },
          "passedCount": {
            "type": "integer",
            "format": "int32",
            "description": "통과한 테스트케이스 수"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "description": "전체 테스트케이스 수"
          },
          "results": {
            "type": "array",
            "description": "테스트케이스별 결과",
            "items": { "$ref": "#/components/schemas/TestCaseResult" }
          }
        }
      },
      "TestCaseResult": {
        "type": "object",
        "properties": {
          "displayOrder": {
            "type": "integer",
            "format": "int32",
            "description": "테스트케이스 순서"
          },
          "hidden": { "type": "boolean", "description": "히든 테스트케이스 여부" },
          "passed": { "type": "boolean", "description": "통과 여부" },
          "status": {
            "type": "string",
            "description": "채점 결과",
            "enum": [
              "PENDING",
              "ACCEPTED",
              "WRONG_ANSWER",
              "COMPILE_ERROR",
              "RUNTIME_ERROR",
              "TIME_LIMIT_EXCEEDED",
              "SYSTEM_ERROR"
            ]
          }
        }
      },
      "ExecutionRequest": {
        "type": "object",
        "properties": {
          "sourceCode": { "type": "string", "description": "실행할 소스 코드", "minLength": 1 },
          "language": {
            "type": "string",
            "description": "프로그래밍 언어",
            "enum": ["C", "CPP", "JAVA", "JAVASCRIPT", "GO", "PYTHON", "KOTLIN"],
            "example": "PYTHON"
          },
          "stdin": { "type": "string", "description": "표준 입력 (선택)" },
          "missionId": {
            "type": "integer",
            "format": "int64",
            "description": "미션 ID (선택). 입력 시 실행 전 드래프트를 자동 저장 후 실행합니다. 미입력 시 드래프트 저장 없이 실행만 수행합니다."
          }
        },
        "required": ["language", "sourceCode"]
      },
      "ApiResponseExecutionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "status": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ExecutionResponse" }
        }
      },
      "ExecutionResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "description": "Judge0 제출 토큰" },
